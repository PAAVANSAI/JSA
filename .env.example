# Environment Configuration for Job Search Automation (JSA)

APP_ENV=development
DB_PATH=jsa_jobs.db

# Layer 1: Career Page APIs
LAYER1_ENABLED=true

# Layer 2: JobSpy (LinkedIn, Indeed, Glassdoor, Google Jobs, Naukri)
LAYER2_ENABLED=true
JOBSPY_ENABLE_NAUKRI=false

# Layer 3: Apify (Indian Portals: Naukri, Foundit, Shine, Instahyre)
LAYER3_ENABLED=false
APIFY_TOKEN=
APIFY_MONTHLY_BUDGET_USD=5.0

# Layer 4: Google Jobs API (RapidAPI / JSearch or DataForSEO)
LAYER4_ENABLED=false
JSEARCH_API_KEY=
DATAFORSEO_AUTH=

# Layer 5: Web Search + AI
LAYER5_ENABLED=false
TAVILY_API_KEY=
SERPER_API_KEY=

# Layer 6 / Notifications: Telegram Alerts & Daily Heartbeat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Matching & Filtering Thresholds
MIN_MATCH_SCORE=65.0
MAX_JOB_AGE_HOURS=48
AUTO_GENERATE_RESUME=true
